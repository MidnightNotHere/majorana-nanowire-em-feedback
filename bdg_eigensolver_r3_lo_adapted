def timed_woodbury_update_lo(solver: PHSymmetricWoodburyLO, delta_B: float,
                             runs: int = 5) -> tuple[float, WoodburyResultLO]:
    if runs < 1:
        raise ValueError("runs must be >= 1")

    base_mu, base_Bz = solver.mu, solver.B_zeeman - delta_B
    times: list[float] = []
    result: WoodburyResultLO

    for _ in range(runs):
        solver.reset(base_mu, base_Bz)
        t0 = time.perf_counter()
        result = solver.update(delta_B=delta_B)
        times.append(time.perf_counter() - t0)

    return statistics.median(times) * 1e3, result

def run_accuracy_validation_lo(N: int = 100, mu0: float = 0.0,
                               B0: float = 1.5, delta0: float = 1.0,
                               delta_B_values=None) -> pd.DataFrame:
    """LO equivalent of Kitaev accuracy validation — steps B_zeeman."""
    if delta_B_values is None:
        delta_B_values = [0.001, 0.005, 0.01, 0.02, 0.05, 0.10, 0.20]

    rows = []
    for dB in delta_B_values:
        H_exact   = build_bdg_lo(N, mu=mu0, B_zeeman=B0 + dB, delta=delta0, t=T_TRIM)
        ev_all, _ = eigh(H_exact)
        idx_exact = np.argsort(np.abs(ev_all))[:K_MODES]
        ev_exact  = np.sort(ev_all[idx_exact])

        solver  = PHSymmetricWoodburyLO(N, mu0, B0, delta0)
        result  = solver.update(delta_B=dB)
        ev_wood = np.sort(result.eigenvalues)
        eval_error = float(np.mean(np.abs(ev_exact - ev_wood)))

        dH = solver._build_delta_H(0.0, dB)
        H0 = build_bdg_lo(N, mu=mu0, B_zeeman=B0, delta=delta0, t=T_TRIM)
        rel_norm = np.linalg.norm(dH, 'fro') / np.linalg.norm(H0, 'fro')

        rows.append({'delta_B': dB, 'rel_norm': rel_norm, 'eval_error': eval_error,
                     'ph_error': result.ph_error, 'used_fallback': result.used_fallback})
    return pd.DataFrame(rows)


def run_performance_comparison_lo(mu0: float = 0.0, B0: float = 1.5,
                                  delta0: float = 1.0, delta_B: float = 0.02,
                                  N_values=(50, 100, 200), runs: int = 5) -> pd.DataFrame:
    """LO head-to-head: full eigh vs Woodbury. Matrix is 4N×4N (2× Kitaev at same N)."""
    rows = []
    for N in N_values:
        H_base    = build_bdg_lo(N, mu=mu0, B_zeeman=B0, delta=delta0, t=T_TRIM)
        time_full = timed_eigh(H_base, runs=runs)

        solver = PHSymmetricWoodburyLO(N, mu0, B0, delta0)
        time_wood, result = timed_woodbury_update_lo(solver, delta_B, runs=runs)

        H_new    = build_bdg_lo(N, mu=mu0, B_zeeman=B0 + delta_B, delta=delta0, t=T_TRIM)
        ev_all, _= eigh(H_new)
        idx      = np.argsort(np.abs(ev_all))[:K_MODES]
        ev_exact = np.sort(ev_all[idx])
        ev_wood  = np.sort(result.eigenvalues)
        eval_err = float(np.mean(np.abs(ev_exact - ev_wood)))

        rows.append({'N': N, 'time_full_ms': round(time_full, 3),
                     'time_wood_ms': round(time_wood, 3),
                     'speedup': round(time_full / max(time_wood, 1e-6), 2),
                     'eval_error': eval_err, 'ph_error': result.ph_error,
                     'used_fallback': result.used_fallback})
    return pd.DataFrame(rows)


def run_sweep_comparison_lo(N=100, mu0=0.0, delta0=1.0,
                            Bz_start=0.5, Bz_end=1.8, n_steps=130,
                            resync_every=2) -> pd.DataFrame:
    """
    LO chained sweep: steps B_zeeman across the topological transition
    at fixed μ=0 (boundary at B_z = sqrt(0²+1²) = 1.0 in these units).
    Mirrors the Kitaev μ-sweep but uses the physically relevant knob
    for R5 (circuit feedback couples to B_z, not μ, via Peierls phase).
    """
    Bz_vals  = np.linspace(Bz_start, Bz_end, n_steps)
    delta_B  = float(Bz_vals[1] - Bz_vals[0])

    solver = PHSymmetricWoodburyLO(N, mu0, Bz_vals[0], delta0)
    rows   = []
    cumulative_rel_norm = 0.0
    RESYNC_REL_NORM_THRESHOLD = 0.008  # just under the Figure 1 breakdown point

    for i, Bz in enumerate(Bz_vals):
        H_exact   = build_bdg_lo(N, mu=mu0, B_zeeman=Bz, delta=delta0, t=T_TRIM)
        ev_all, _ = eigh(H_exact)
        idx_exact = np.argsort(np.abs(ev_all))[:K_MODES]
        ev_exact  = np.sort(ev_all[idx_exact])

        if i == 0 or cumulative_rel_norm >= RESYNC_REL_NORM_THRESHOLD or i == len(Bz_vals) - 1:

            solver.reset(mu0, Bz, delta0)
            cumulative_rel_norm = 0.0
            ev_wood, ph_err, used_fallback, step_ms = (
                np.sort(solver._evals), 0.0, True, 0.0)
        else:
            t0     = time.perf_counter()
            result = solver.update(delta_B=delta_B)
            cumulative_rel_norm += result.perturbation_norm
            step_ms = (time.perf_counter() - t0) * 1e3
            ev_wood, ph_err, used_fallback = (
                np.sort(result.eigenvalues), result.ph_error, result.used_fallback)

        rows.append({'B_zeeman': Bz,
                     'ev_exact_min': float(np.min(np.abs(ev_exact))),
                     'ev_wood_min':  float(np.min(np.abs(ev_wood))),
                     'abs_error':    float(np.mean(np.abs(ev_exact - ev_wood))),
                     'ph_error': ph_err, 'used_fallback': used_fallback,
                     'step_time_ms': step_ms})
    return pd.DataFrame(rows)


