class PHSymmetricWoodburyLO:
    """
    PH-symmetric rank-2 Woodbury updater for Lutchyn-Oreg BdG near-zero
    modes. Same algorithm as the validated Kitaev-chain version; only
    the Hamiltonian, PH operator, and perturbation set change.

    Parameters tracked: mu, B_zeeman, delta (delta usually held fixed
    at 1.0 — the physically tunable knobs are mu via gate voltage and
    B_zeeman via external field / circuit feedback).
    """

    def __init__(self, N: int, mu: float, B_zeeman: float,
                delta: float = 1.0, t: float = T_TRIM):
        self.N        = N
        self.mu       = mu
        self.B_zeeman = B_zeeman
        self.delta    = delta
        self.t        = t
        self._steps_since_refresh = 0
        self._full_solve()

    def _full_solve(self) -> None:
        """Re-diagonalise fully at current (mu, B_zeeman, delta)."""
        H = build_bdg_lo(self.N, mu=self.mu, B_zeeman=self.B_zeeman,
                         delta=self.delta, t=self.t)
        check_ph_symmetry_complex(H, self.N)   # hard assert

        all_evals, all_evecs = eigh(H)
        idx   = np.argsort(np.abs(all_evals))[:K_MODES]
        self._H      = H
        self._evals  = all_evals[idx]
        self._evecs  = all_evecs[:, idx]
        self._H_norm = np.linalg.norm(H, 'fro')

    def _build_delta_H(self, delta_mu: float, delta_B: float,
                       delta_delta: float = 0.0) -> np.ndarray:
        """
        Construct δH for LO model parameter steps. PH-symmetric by
        construction (verified below) because each term is built from
        the same blocks as build_bdg_lo's PH-preserving structure.

        δμ : diagonal in both spin sectors, 2N×2N kinetic block
        δB : diagonal ⊗ σ_z, splits spin sectors oppositely
        δΔ : pairing block, i·σ_y ⊗ I_N structure (rarely stepped —
             Δ is material-fixed, kept for API completeness)
        """
        N = self.N
        two_N = 2 * N
        dH = np.zeros((4 * N, 4 * N), dtype=complex)

        I2  = np.eye(2, dtype=complex)
        I_N = np.eye(N, dtype=complex)
        sz  = np.array([[1, 0], [0, -1]], dtype=complex)

        if delta_mu != 0.0:
            d_kin = -delta_mu * np.kron(I2, I_N)        # 2N×2N
            dH[:two_N, :two_N]   += d_kin
            dH[two_N:, two_N:]   += -d_kin.conj()        # PH-conjugate hole block

        if delta_B != 0.0:
            d_Z = delta_B * np.kron(sz, I_N)              # 2N×2N
            dH[:two_N, :two_N]   += d_Z
            dH[two_N:, two_N:]   += -d_Z.conj()

        if delta_delta != 0.0:
            i_sy = np.array([[0, 1], [-1, 0]], dtype=complex)
            d_pair = delta_delta * np.kron(i_sy, I_N)     # 2N×2N
            dH[:two_N, two_N:]   += d_pair
            dH[two_N:, :two_N]   += -d_pair.T.conj()

        return dH

    def _validate_ph_symmetry_of_perturbation(self, dH: np.ndarray) -> None:
        """Assert δH satisfies Σ_x δH* Σ_x = -δH (complex PH operator)."""
        two_N = 2 * self.N
        Sigma_x = np.block([[np.zeros((two_N, two_N)), np.eye(two_N)],
                            [np.eye(two_N),            np.zeros((two_N, two_N))]])
        err = np.linalg.norm(dH + Sigma_x @ dH.conj() @ Sigma_x)
        if err > 1e-12 * max(1.0, np.linalg.norm(dH, 'fro')):
            raise ValueError(
                f"Perturbation δH breaks PH symmetry (LO): ‖δH+Σ_x δH* Σ_x‖={err:.2e}."
            )

    def update(self, delta_mu: float = 0.0, delta_B: float = 0.0,
              delta_delta: float = 0.0) -> 'WoodburyResultLO':
        """
        Apply a (δμ, δB_z, δΔ) step. Algorithm identical to validated
        Kitaev R3: REFRESH_INTERVAL subspace reset → perturbation/gap
        fallback checks → DPT (direction) → RR1 → RR2 → residual check
        → PH re-symmetrisation.
        """
        if delta_mu == 0.0 and delta_B == 0.0 and delta_delta == 0.0:
            return WoodburyResultLO(
                eigenvalues=self._evals.copy(), eigenvectors=self._evecs.copy(),
                used_fallback=False, ph_error=0.0, perturbation_norm=0.0,
                mu=self.mu, B_zeeman=self.B_zeeman, delta=self.delta,
            )

        dH = self._build_delta_H(delta_mu, delta_B, delta_delta)
        self._validate_ph_symmetry_of_perturbation(dH)
        rel_norm = np.linalg.norm(dH, 'fro') / max(self._H_norm, 1e-14)

        self.mu       += delta_mu
        self.B_zeeman += delta_B
        self.delta    += delta_delta
        self._steps_since_refresh += 1

        # ── Periodic subspace refresh (prevents accumulated drift) ──
        if self._steps_since_refresh >= REFRESH_INTERVAL:
            self._full_solve()
            self._steps_since_refresh = 0
            ph_error = check_ph_symmetry_complex(self._H, self.N)
            return WoodburyResultLO(
                eigenvalues=self._evals.copy(), eigenvectors=self._evecs.copy(),
                used_fallback=True, ph_error=ph_error, perturbation_norm=rel_norm,
                mu=self.mu, B_zeeman=self.B_zeeman, delta=self.delta,
            )

        # ── Fallback conditions ──────────────────────────────────────
        too_large   = rel_norm > PERTURBATION_THRESHOLD
        current_gap = float(np.min(np.abs(self._evals)))
        V_test      = self._evecs
        M_test      = V_test.conj().T @ dH @ V_test
        d_evals_test, _ = eigh(M_test)
        projected_gap = float(np.min(np.abs(self._evals + d_evals_test)))
        near_critical = (projected_gap < GAP_SAFETY_THRESHOLD and
                         projected_gap < 0.1 * current_gap)

        if too_large or near_critical:
            reason = "large perturbation" if too_large else "gap collapsing at phase transition"
            warnings.warn(f"R3-LO fallback ({reason}): rel_norm={rel_norm:.3f}, "
                          f"gap={current_gap:.2e}.", stacklevel=2)
            self._full_solve()
            self._steps_since_refresh = 0
            ph_error = check_ph_symmetry_complex(self._H, self.N)
            return WoodburyResultLO(
                eigenvalues=self._evals.copy(), eigenvectors=self._evecs.copy(),
                used_fallback=True, ph_error=ph_error, perturbation_norm=rel_norm,
                mu=self.mu, B_zeeman=self.B_zeeman, delta=self.delta,
            )

        # ── DPT (direction) → RR1 (2nd order) → RR2 (3rd order) ──────
        V_old = self._evecs
        H_new = self._H + dH

        M_dpt = V_old.conj().T @ dH @ V_old
        _, d_evecs = eigh(M_dpt)
        V_dpt = V_old @ d_evecs

        M1 = V_dpt.conj().T @ H_new @ V_dpt
        evals1, evecs1 = eigh(M1)
        V1 = V_dpt @ evecs1

        M2 = V1.conj().T @ H_new @ V1
        evals2, evecs2 = eigh(M2)
        new_evals = evals2
        new_evecs = V1 @ evecs2


        

        # ── Residual check ────────────────────────────────────────────
        HV  = H_new @ new_evecs
        LV  = new_evals[np.newaxis, :] * new_evecs
        max_residual = float(np.max(np.linalg.norm(HV - LV, axis=0)))

       
        
        if max_residual > RR_RESIDUAL_FACTOR * rel_norm:
            warnings.warn(f"R3-LO double-RR residual too large: "
                          f"{max_residual:.2e} > {RR_RESIDUAL_FACTOR}×{rel_norm:.4f}.",
                          stacklevel=2)
            self._H = H_new
            self._full_solve()
            self._steps_since_refresh = 0
            ph_error = check_ph_symmetry_complex(self._H, self.N)
            return WoodburyResultLO(
                eigenvalues=self._evals.copy(), eigenvectors=self._evecs.copy(),
                used_fallback=True, ph_error=ph_error, perturbation_norm=rel_norm,
                mu=self.mu, B_zeeman=self.B_zeeman, delta=self.delta,
            )

        # ── PH re-symmetrisation (belt-and-braces vs drift) ───────────
        k = len(new_evals)
        for i in range(k // 2):
            j = k - 1 - i
            e_mean = (new_evals[i] - new_evals[j]) / 2.0
            new_evals[i], new_evals[j] = e_mean, -e_mean

        self._H, self._H_norm = H_new, np.linalg.norm(H_new, 'fro')
        self._evals, self._evecs = new_evals, new_evecs
        ph_error = check_ph_symmetry_complex(self._H, self.N)

        return WoodburyResultLO(
            eigenvalues=new_evals, eigenvectors=new_evecs, used_fallback=False,
            ph_error=ph_error, perturbation_norm=rel_norm,
            mu=self.mu, B_zeeman=self.B_zeeman, delta=self.delta,
        )

    def reset(self, mu: float, B_zeeman: float, delta: float | None = None) -> None:
        self.mu, self.B_zeeman = mu, B_zeeman
        if delta is not None:
            self.delta = delta
        self._full_solve()
        self._steps_since_refresh

class WoodburyResultLO:
    __slots__ = ('eigenvalues', 'eigenvectors', 'used_fallback', 'ph_error',
                'perturbation_norm', 'mu', 'B_zeeman', 'delta')

    def __init__(self, eigenvalues, eigenvectors, used_fallback, ph_error,
                perturbation_norm, mu, B_zeeman, delta):
        self.eigenvalues, self.eigenvectors = eigenvalues, eigenvectors
        self.used_fallback, self.ph_error   = used_fallback, ph_error
        self.perturbation_norm = perturbation_norm
        self.mu, self.B_zeeman, self.delta  = mu, B_zeeman, delta

    def __repr__(self):
        return (f"WoodburyResultLO(mu={self.mu:.4f}, B_z={self.B_zeeman:.4f}, "
                f"fallback={self.used_fallback}, ph_err={self.ph_error:.2e})")


