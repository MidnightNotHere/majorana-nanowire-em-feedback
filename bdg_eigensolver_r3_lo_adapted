def plot_accuracy_vs_perturbation_lo(df, save_path='r3_lo_figure1_accuracy.png'):
    fig, ax = plt.subplots(figsize=(8, 5))
    fb, wd = df[df['used_fallback']], df[~df['used_fallback']]

    ax.loglog(wd['rel_norm'], wd['eval_error'], 'o-', color=COLORS['Topological'],
              linewidth=2, markersize=8, label='Woodbury DPT + Double-RR (LO model)')
    if not fb.empty:
        ax.loglog(fb['rel_norm'], fb['eval_error'], 's', color=COLORS['Trivial'],
                  markersize=10, label='Fallback (full eigh — exact)')
    if not wd.empty:
        x_ref = np.array([wd['rel_norm'].min(), wd['rel_norm'].max()])
        s1 = wd['eval_error'].iloc[0] / max(wd['rel_norm'].iloc[0], 1e-14)
        s2 = wd['eval_error'].iloc[0] / max(wd['rel_norm'].iloc[0]**2, 1e-28)
        ax.loglog(x_ref, s1*x_ref,   'k--', alpha=0.5, label='O(δ) reference')
        ax.loglog(x_ref, s2*x_ref**2,'k:',  alpha=0.4, label='O(δ²) reference')

    # ── Subspace breakdown annotation (K_MODES=2 specific) ──────
    breakdown_start = 0.006   # from observed Figure 1 divergence point
    ax.axvspan(breakdown_start, PERTURBATION_THRESHOLD,
               alpha=0.08, color='red',
               label='Subspace approximation breakdown (K_MODES=2)')

    ax.axvline(PERTURBATION_THRESHOLD, color='gray', linestyle=':', linewidth=1.5,
              label=f'Fallback threshold ({PERTURBATION_THRESHOLD})')
    ax.set_xlabel('Perturbation norm |δH|_F / |H|_F')
    ax.set_ylabel('Mean absolute eigenvalue error')
    ax.set_title(f'R3-LO: Near-Zero Mode Accuracy vs δB_z\n(N=100, μ=0, K_MODES={K_MODES})')
    ax.legend(loc='upper left', bbox_to_anchor=(1.02, 1.0), fontsize=10, framealpha=0.9)
    plt.tight_layout(); plt.savefig(save_path, dpi=300, bbox_inches='tight')
    plt.close(); print(f"Saved: {save_path}")


def plot_speedup_lo(df, save_path='r3_lo_figure2_speedup.png'):
    fig, axes = plt.subplots(1, 2, figsize=(13, 5))
    ax = axes[0]; x = np.arange(len(df)); w = 0.35
    ax.bar(x-w/2, df['time_full_ms'], w, label='Full eigh (4N×4N)', color=COLORS['Trivial'], alpha=0.85)
    ax.bar(x+w/2, df['time_wood_ms'], w, label='Woodbury (R3-LO)', color=COLORS['Topological'], alpha=0.85)
    for i, row in df.iterrows():
        ax.text(i+w/2, row['time_wood_ms']+0.3, f"{row['speedup']:.1f}×",
                ha='center', fontsize=11, color=COLORS['Topological'], fontweight='bold')
    ax.set_xticks(x); ax.set_xticklabels([f'N={n}' for n in df['N']])
    ax.set_ylabel('Solve time (ms)'); ax.set_title('R3-LO vs Full eigh (δB_z=0.02)')
    ax.legend(); ax.grid(True, alpha=0.3, axis='y')
    ax2 = axes[1]
    ax2.semilogy(df['N'], df['eval_error'], 'o-', color=COLORS['accent'], linewidth=2, markersize=8)
    ax2.set_xlabel('System size N'); ax2.set_ylabel('Mean eigenvalue error (log)')
    ax2.set_title('LO Woodbury Error vs N'); ax2.grid(True, alpha=0.3); ax2.set_xticks(df['N'].tolist())
    plt.suptitle('R3-LO Performance and Accuracy Summary', fontsize=13, fontweight='bold')
    plt.tight_layout(); plt.savefig(save_path, dpi=300, bbox_inches='tight')
    plt.close(); print(f"Saved: {save_path}")


def plot_sweep_tracking_lo(df, mu0=0.0, delta0=1.0,
                           save_path='r3_lo_figure3_sweep_tracking.png'):
    fig, axes = plt.subplots(2, 1, figsize=(9, 8), sharex=True)
    ax1 = axes[0]
    ax1.plot(df['B_zeeman'], df['ev_exact_min'], 'k-', linewidth=2, label='Exact (full eigh)')
    ax1.plot(df['B_zeeman'], df['ev_wood_min'], '--', color=COLORS['Topological'],
             linewidth=2, label='Woodbury (LO)')
    fb = df[df['used_fallback']]
    if not fb.empty:
        ax1.scatter(fb['B_zeeman'], fb['ev_wood_min'], color=COLORS['Trivial'],
                   s=80, zorder=5, label='Fallback triggered')
    Bc = np.sqrt(mu0**2 + delta0**2)
    ax1.axvline(Bc, color='gray', linestyle=':', linewidth=1.5, label=f'Analytic boundary B_z={Bc:.2f}')
    ax1.set_ylabel('Min |eigenvalue| (Majorana gap)')
    ax1.set_title(f'R3-LO Chained Woodbury: B_z sweep at μ=0 (N=100, simulates R5)')
    ax1.legend(loc='upper right', fontsize=9, framealpha=0.9)
    ax1.grid(True, alpha=0.3)

    ax2 = axes[1]
    ax2.semilogy(df['B_zeeman'], df['abs_error']+1e-16, '-', color=COLORS['accent'],
                linewidth=2, label='Abs eigenvalue error')
    ax2.semilogy(df['B_zeeman'], df['ph_error']+1e-16, '--', color=COLORS['Trivial'],
                linewidth=1.5, label='PH error')
    ax2.axhline(1e-6, color='gray', linestyle=':', linewidth=1, label='1e-6 target')

    # ── Option D — honest drift-band annotation ────────────────────
    # Bounded, self-correcting drift between resyncs. Peak height taken
    # from observed sawtooth maxima across the validated sweep (see R3-LO
    # accuracy log: max eigenvalue error 2.20e-04 with fallback safety net
    # engaging whenever double-RR residual exceeds its threshold).
    DRIFT_BAND_LOW  = 1e-6
    DRIFT_BAND_HIGH = 3e-4
    ax2.axhspan(DRIFT_BAND_LOW, DRIFT_BAND_HIGH, alpha=0.10, color='orange',
               label='Expected drift between resyncs\n(bounded, self-correcting)')

    ax2.set_xlabel('Zeeman energy B_z')
    ax2.set_ylabel('Error (log scale)')
    ax2.set_title('Error Accumulation Across Chained B_z Updates')
    ax2.legend(loc='upper left', bbox_to_anchor=(1.02, 1.0), fontsize=9, framealpha=0.9)
    ax2.grid(True, alpha=0.3, which='both')

    plt.tight_layout()
    plt.savefig(save_path, dpi=300, bbox_inches='tight')
    plt.close()
    print(f"Saved: {save_path}")


